# Copia este archivo a ".env" (en la raíz del repo) y completa los valores
# reales. docker-compose lee ese archivo automáticamente.

# --- Backend ---
CADENA_POSTGRES=Host=aws-0-us-west-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.xxxxxxxxxxxx;Password=xxxx;SSL Mode=Require;Trust Server Certificate=true
JWT_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ONEDRIVE_URL=https://1drv.ms/f/c/xxxxx

# Correo transaccional por la API HTTP de Brevo (no SMTP: la mayoría de
# plataformas de hosting bloquean los puertos SMTP salientes).
BREVO_API_KEY=xkeysib-xxxx
BREVO_REMITENTE_EMAIL=remitente-verificado@tu-dominio.com
BREVO_REMITENTE_NOMBRE=CASAGRES

# URL pública donde queda expuesto el frontend (se usa para CORS y para los
# enlaces de verificación de correo / recuperación de contraseña).
FRONTEND_URL=http://localhost:8081

# --- Frontend ---
# URL pública donde queda expuesta la API del backend. Se usa como build-arg
# (queda incrustada en el bundle de React, no se puede cambiar después sin
# reconstruir la imagen).
VITE_API_URL=http://localhost:8090/api
